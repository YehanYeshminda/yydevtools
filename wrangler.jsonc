{
  // Cloudflare Worker for the yydevtools SPA.
  // `npm run build` produces the assets; `wrangler deploy` uploads them.
  //
  // The Worker serves the static site for every path except /api/*, which is
  // handled by worker/index.ts. The operations that cannot run in the browser
  // (convert, OCR, compress) are proxied to self-hosted Fly services — merge,
  // split, viewing and image compression stay entirely client-side.
  //
  // The build prerenders every route to its own HTML file, so there is no SPA
  // fallback: unmatched paths fall through to the Worker, which answers with
  // the prerendered /404 page and a real 404 status.
  "name": "yydevtools",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  // Keep the *.workers.dev URL alive alongside the custom domain.
  "workers_dev": true,
  "assets": {
    "directory": "./dist/yydevtools/browser",
    // Bound so the Worker can serve the prerendered pages for non-API routes.
    "binding": "ASSETS",
    // Let misses reach the Worker so it can answer with a real 404 status.
    "not_found_handling": "none",
    // Serve /tools/pdf-merge directly instead of 307-ing to the trailing-slash
    // form. The default (auto-trailing-slash) put a redirect hop in front of
    // every canonical URL and every link in the sitemap.
    "html_handling": "drop-trailing-slash",
    // Worker-first by default (`/*`), so every HTML page, unknown path and
    // /api/* route still gets the www redirect, the real 404 status and the
    // Worker's security headers, exactly as before. The exceptions below are
    // the build's content-hashed bundles and the three vendored, stable-named
    // asset trees (image codecs, the OCR engine, pdf.js) — none of them is
    // ever a navigation target or something a search engine indexes, so they
    // can serve straight from the edge without the Worker in front of them.
    // Their headers move to public/_headers, which only takes effect for
    // responses that bypass the Worker like these now do — see the note at
    // the top of that file.
    "run_worker_first": [
      "/*",
      "!/main-*.js",
      "!/chunk-*.js",
      "!/worker-*.js",
      "!/styles-*.css",
      "!/wasm/*",
      "!/tesseract/*",
      "!/pdfjs/*",
    ],
  },
  // Custom domains — wrangler creates the DNS records if yydevtools.com is on
  // this account. www is registered only so it resolves at all (it had no DNS
  // record, so visitors who typed it got a DNS error); the Worker 301s it to
  // the apex, which stays canonical.
  "routes": [
    { "pattern": "yydevtools.com", "custom_domain": true },
    { "pattern": "www.yydevtools.com", "custom_domain": true },
  ],
  "vars": {
    // Base URLs of the self-hosted Fly services. Each has a matching secret that
    // is NOT stored here — set them with:
    //   npx wrangler secret put PDF_COMPRESS_SECRET
    //   npx wrangler secret put PDF_OCR_SECRET
    //   npx wrangler secret put PDF_CONVERT_SECRET
    //   npx wrangler secret put OFFICE_CONVERT_SECRET
    "PDF_COMPRESS_URL": "https://yydevtools-pdf-compress.fly.dev",
    "PDF_OCR_URL": "https://yydevtools-pdf-ocr.fly.dev",
    "PDF_CONVERT_URL": "https://yydevtools-pdf-convert.fly.dev",
    // ASP.NET Core, not Node like its three siblings above — see
    // services/office-convert/Program.cs for why. Converts .docx to SFDT and .xlsx
    // to workbook JSON, for the Word and Excel Viewers' Syncfusion components.
    "OFFICE_CONVERT_URL": "https://yydevtools-office-convert.fly.dev",
    // Upstash Redis for global rate limiting AND the cached news feed. The URL
    // is safe to keep here; the token is a secret — set it with:
    //   npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
    "UPSTASH_REDIS_REST_URL": "https://moral-kid-122505.upstash.io",
    // CurrentsAPI key for the /api/news feed is a secret, not a var — set it with:
    //   npx wrangler secret put CURRENTS_API_KEY
    // and put a local copy in .dev.vars for `wrangler dev`.
  },
  // Per-IP rate limit for the /api/* operations, so nobody can hammer the
  // (metered-compute) Fly services. Keyed by CF-Connecting-IP in worker/index.ts.
  // Note: the limiter is per-Cloudflare-location and eventually consistent — an
  // abuse guard, not an exact counter. `period` must be 10 or 60 (seconds).
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
