# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node — unanchored so services/*/node_modules is covered too
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
# Playwright run output (traces, screenshots, JSON report) and its HTML report
/e2e/.results/
/e2e/.report/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Assistant / editor tooling config — not part of the project
.claude/

# Secrets — never commit
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Cloudflare Worker local state
.wrangler/

# Fly.io local state for services/*
.fly/

# Generated by scripts/generate-syncfusion-license.mjs — carries whatever
# SYNCFUSION_LICENSE_KEY is set in the environment, never a hand-committed key.
src/app/core/syncfusion-license.generated.ts

# .NET build output for services/office-convert — includes the restored
# Syncfusion assemblies, which are licensed binaries and have no business in
# a public repo. The Dockerfile restores them at build time instead.
[Bb]in/
[Oo]bj/
