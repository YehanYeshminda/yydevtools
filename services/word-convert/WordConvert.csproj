<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in Syncfusion.DocIO.Net.Core, Syncfusion.Compression.Net.Core and
         Syncfusion.OfficeChart.Net.Core transitively — the managed OOXML engine
         that reads a .docx and walks it into the object graph Import serializes
         to SFDT. Nothing here shells out to an external binary, unlike the
         Ghostscript/LibreOffice/Tesseract services, which is also why this
         service has no /health tool-verification step: there is no separate
         "is it installed" question — either the assembly loaded or the process
         never started. -->
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="34.2.6" />
    <PackageReference Include="Syncfusion.Licensing" Version="34.2.6" />
  </ItemGroup>

</Project>
