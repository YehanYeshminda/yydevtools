{
    "$schema":  "./node_modules/@angular/cli/lib/config/schema.json",
    "version":  1,
    "cli":  {
                "packageManager":  "npm"
            },
    "newProjectRoot":  "projects",
    "projects":  {
                     "yydevtools":  {
                                        "projectType":  "application",
                                        "schematics":  {
                                                           "@schematics/angular:class":  {
                                                                                             "skipTests":  true
                                                                                         },
                                                           "@schematics/angular:component":  {
                                                                                                 "skipTests":  true
                                                                                             },
                                                           "@schematics/angular:directive":  {
                                                                                                 "skipTests":  true
                                                                                             },
                                                           "@schematics/angular:guard":  {
                                                                                             "skipTests":  true
                                                                                         },
                                                           "@schematics/angular:interceptor":  {
                                                                                                   "skipTests":  true
                                                                                               },
                                                           "@schematics/angular:pipe":  {
                                                                                            "skipTests":  true
                                                                                        },
                                                           "@schematics/angular:resolver":  {
                                                                                                "skipTests":  true
                                                                                            },
                                                           "@schematics/angular:service":  {
                                                                                               "skipTests":  true
                                                                                           }
                                                       },
                                        "root":  "",
                                        "sourceRoot":  "src",
                                        "prefix":  "app",
                                        "architect":  {
                                                          "build":  {
                                                                        "builder":  "@angular/build:application",
                                                                        "options":  {
                                                                                        "browser":  "src/main.ts",
                                                                                        "tsConfig":  "tsconfig.app.json",
                                                                                        "assets":  [
                                                                                                       {
                                                                                                           "glob":  "**/*",
                                                                                                           "input":  "public"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "*-latin*-wght-normal.woff2",
                                                                                                           "input":  "node_modules/@fontsource-variable/geist/files",
                                                                                                           "output":  "fonts"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "*-latin*-wght-normal.woff2",
                                                                                                           "input":  "node_modules/@fontsource-variable/jetbrains-mono/files",
                                                                                                           "output":  "fonts"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "*.wasm",
                                                                                                           "input":  "node_modules/@jsquash/jpeg/codec/enc",
                                                                                                           "output":  "wasm"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "*.wasm",
                                                                                                           "input":  "node_modules/@jsquash/webp/codec/enc",
                                                                                                           "output":  "wasm"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "ort-wasm-simd-threaded.wasm",
                                                                                                           "input":  "node_modules/onnxruntime-web/dist",
                                                                                                           "output":  "wasm"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "ort-wasm-simd-threaded.mjs",
                                                                                                           "input":  "node_modules/onnxruntime-web/dist",
                                                                                                           "output":  "wasm"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "worker.min.js",
                                                                                                           "input":  "node_modules/tesseract.js/dist",
                                                                                                           "output":  "tesseract"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "*-lstm.wasm.js",
                                                                                                           "input":  "node_modules/tesseract.js-core",
                                                                                                           "output":  "tesseract"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "eng.traineddata.gz",
                                                                                                           "input":  "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                                                                                                           "output":  "tesseract"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "sin.traineddata.gz",
                                                                                                           "input":  "node_modules/@tesseract.js-data/sin/4.0.0_best_int",
                                                                                                           "output":  "tesseract"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "tam.traineddata.gz",
                                                                                                           "input":  "node_modules/@tesseract.js-data/tam/4.0.0_best_int",
                                                                                                           "output":  "tesseract"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "zxing_reader.wasm",
                                                                                                           "input":  "node_modules/zxing-wasm/dist/reader",
                                                                                                           "output":  "zxing"
                                                                                                       }
                                                                                                   ],
                                                                                        "styles":  [
                                                                                                       "src/material-theme.scss",
                                                                                                       "src/styles.css"
                                                                                                   ],
                                                                                        "allowedCommonJsDependencies":  [
                                                                                                                            "pako",
                                                                                                                            "color",
                                                                                                                            "crypto-js",
                                                                                                                            "node-html-better-parser",
                                                                                                                            "qrcode",
                                                                                                                            "cron-parser",
                                                                                                                            "cronstrue",
                                                                                                                            "nearley",
                                                                                                                            "yaml",
                                                                                                                            "@xml-tools/parser",
                                                                                                                            "secure-random-password",
                                                                                                                            "secure-random-password/lib/random",
              "papaparse"
                                                                                                                        ],
                                                                                        "server":  "src/main.server.ts",
                                                                                        "outputMode":  "static",
                                                                                        "security":  {
                                                                                                         "allowedHosts":  [

                                                                                                                          ]
                                                                                                     }
                                                                                    },
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "budgets":  [
                                                                                                                                  {
                                                                                                                                      "type":  "initial",
                                                                                                                                      "maximumWarning":  "700kB",
                                                                                                                                      "maximumError":  "1MB"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "type":  "anyComponentStyle",
                                                                                                                                      "maximumWarning":  "8kB",
                                                                                                                                      "maximumError":  "350kB"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                                  "outputHashing":  "all"
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "optimization":  false,
                                                                                                                   "extractLicenses":  false,
                                                                                                                   "sourceMap":  true
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "production"
                                                                    },
                                                          "serve":  {
                                                                        "builder":  "@angular/build:dev-server",
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "buildTarget":  "yydevtools:build:production"
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "buildTarget":  "yydevtools:build:development"
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "development"
                                                                    },
                                                          "test":  {
                                                                        "builder":  "@angular/build:unit-test",
                                                                        "options":  {
                                                                                        "buildTarget":  "yydevtools:build:development",
                                                                                        "tsConfig":  "tsconfig.spec.json",
                                                                                        "runner":  "vitest"
                                                                                    }
                                                                    }
                                                      }
                                    }
                 }
}
